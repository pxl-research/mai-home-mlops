{
  "annotations": { "list": [] },
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "household",
        "label": "Household",
        "type": "custom",
        "query": "single_be,single_nl,couple_be,couple_nl,family_be,family_nl",
        "current": { "text": "All", "value": "$__all" },
        "options": [],
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "datasource": { "type": "postgres", "uid": "P12345678" },
      "repeat": "household",
      "repeatDirection": "v",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "has_leakage" },
            "properties": [
              { "id": "custom.drawStyle", "value": "bars" },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "custom.fillOpacity", "value": 70 },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 1 },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "title": "Water Consumption & Leak Detection - $household",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "P12345678" },
          "format": "time_series",
          "rawSql": "SELECT timestamp AS \"time\", volume_liter FROM household_water_usage WHERE household_id = '$household' AND $__timeFilter(timestamp) ORDER BY 1",
          "refId": "A"
        },
        {
          "datasource": { "type": "postgres", "uid": "P12345678" },
          "format": "time_series",
          "rawSql": "SELECT timestamp AS \"time\", has_leakage::int AS has_leakage FROM household_water_usage WHERE household_id = '$household' AND $__timeFilter(timestamp) ORDER BY 1",
          "refId": "B"
        }
      ]
    }
  ],
  "title": "Household Water Usage Overview",
  "uid": "sensor-dashboard",
  "schemaVersion": 36
}
